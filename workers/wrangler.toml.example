name = "democracy-paper-suggestions"
main = "suggest-paper-worker.js"
compatibility_date = "2026-05-19"

[vars]
GITHUB_OWNER = "demokratia-info"
GITHUB_REPO = "democracy-paper-suggestions-private"
GITHUB_BRANCH = "main"
QUEUE_PATH = "suggest_queue.csv"
SUGGEST_CONFIRMATION_QUEUE_PATH = "suggest_confirmation_queue.csv"
SUGGEST_CONFIRMATION_EXPIRY_DAYS = "7"
FEEDBACK_QUEUE_PATH = "page_feedback_queue.csv"
FEEDBACK_HISTORY_PATH = "page_feedback_history.csv"
AUTHOR_NOTICE_QUEUE_PATH = "author_notice_queue.csv"
FEEDBACK_PHOTO_DIR = "page_feedback_photos"
PAGE_FEEDBACK_PHOTO_MAX_BYTES = "8388608"
PAGE_FEEDBACK_DAILY_LIMIT = "5"
ALLOWED_ORIGINS = "https://democracy.tau.ac.il,https://demokratia-info.github.io"
SITE_ORIGIN = "https://democracy.tau.ac.il"
CONFIRMATION_BASE_URL = "https://democracy-paper-suggestions.demokratia-info.workers.dev"
CONFIRMATION_MAIL_FROM = "Demokratia <notifications@example.com>"
CONFIRMATION_MAIL_REPLY_TO = "demokratia.info@gmail.com"
CONFIRMATION_REPORT_TO = "demokratia.info@gmail.com"
# Set one of these as a Worker secret, not here:
# EDITOR_PASSWORD
# EDITOR_PASSWORD_SHA256
# CONFIRMATION_TOKEN_SECRET
# RESEND_API_KEY
# Or use CONFIRMATION_EMAIL_WEBHOOK_URL and optional CONFIRMATION_EMAIL_WEBHOOK_TOKEN
