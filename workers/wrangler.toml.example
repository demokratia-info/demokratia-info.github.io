name = "democracy-paper-suggestions"
main = "suggest-paper-worker.js"
compatibility_date = "2026-05-19"

[vars]
GITHUB_OWNER = "demokratia-info"
GITHUB_REPO = "democracy-paper-suggestions-private"
GITHUB_BRANCH = "main"
QUEUE_PATH = "suggest_queue.csv"
FEEDBACK_QUEUE_PATH = "page_feedback_queue.csv"
FEEDBACK_HISTORY_PATH = "page_feedback_history.csv"
AUTHOR_NOTICE_QUEUE_PATH = "author_notice_queue.csv"
FEEDBACK_PHOTO_DIR = "page_feedback_photos"
PAGE_FEEDBACK_PHOTO_MAX_BYTES = "8388608"
PAGE_FEEDBACK_DAILY_LIMIT = "5"
ALLOWED_ORIGINS = "https://demokratia-info.github.io"
SITE_ORIGIN = "https://demokratia-info.github.io"
# Set one of these as a Worker secret, not here:
# EDITOR_PASSWORD
# EDITOR_PASSWORD_SHA256
